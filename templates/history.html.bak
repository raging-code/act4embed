<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>History - Gas & Vibration Monitor</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<header>
  <h1>Gas & Vibration Monitor</h1>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/history" aria-current="page">History</a>
  </nav>
</header>

<main>
  {% if sim %}<div class="banner info">Simulation mode: the logged data is fake.</div>{% endif %}
  <section class="panel">
    <div class="row" style="margin:0">
      <div><label for="preset">Time range</label>
        <select id="preset">
          <option value="3600">Last hour</option>
          <option value="21600">Last 6 hours</option>
          <option value="86400">Last 24 hours</option>
          <option value="604800">Last 7 days</option>
          <option value="all">All data</option>
          <option value="custom">Custom...</option>
        </select></div>
      <div id="customBox" class="row" hidden style="margin:0">
        <div><label for="from">From</label><input id="from" type="datetime-local"></div>
        <div><label for="to">To</label><input id="to" type="datetime-local"></div>
      </div>
      <div style="align-self:end" class="row"><button id="apply">Show</button><a id="csv" class="btn" href="/export.csv?range=3600">Download CSV</a></div>
    </div>
  </section>

  <section class="panel">
    <div class="stats">
      <div><b id="sN">--</b><span class="muted">readings</span></div>
      <div><b id="sMax">--</b><span class="muted">highest gas</span></div>
      <div><b id="sAvg">--</b><span class="muted">average gas</span></div>
      <div><b id="sVib">--</b><span class="muted">vibration readings</span></div>
      <div><b id="sAlerts">--</b><span class="muted">alerts</span></div>
    </div>
  </section>

  <section class="panel">
    <h2>Gas trend</h2>
    <div class="chart-box"><canvas id="chart" role="img" aria-label="Historical gas and vibration trend"></canvas></div>
    <p id="empty" class="muted" hidden>No data in this range yet. Leave the dashboard app running to collect readings.</p>
  </section>

  <section class="two">
    <div class="panel"><h2>Alert log</h2>
      <div class="scroll"><table><thead><tr><th>Time</th><th>Type</th><th>Details</th><th>Email</th></tr></thead><tbody id="alerts"></tbody></table></div></div>
    <div class="panel"><h2>Latest readings (max 100)</h2>
      <div class="scroll"><table><thead><tr><th>Time</th><th>Gas</th><th>Vibration</th><th>Status</th></tr></thead><tbody id="rows"></tbody></table></div></div>
  </section>
</main>

<script src="{{ url_for('static', filename='chart.umd.js') }}"></script>
<script>
const $ = id => document.getElementById(id);
const chart = new Chart($('chart'), {
  type: 'line',
  data: { labels: [], datasets: [
    { label: 'Average gas', data: [], borderColor: '#0f7f9c', borderWidth: 2, pointRadius: 0, tension: .2, yAxisID: 'y' },
    { label: 'Threshold', data: [], borderColor: '#c22f2f', borderDash: [6, 4], borderWidth: 1.5, pointRadius: 0, yAxisID: 'y' },
    { label: 'Vibration seen', data: [], borderColor: 'rgba(0,0,0,0)', backgroundColor: 'rgba(240,160,40,.4)', fill: true, stepped: true, pointRadius: 0, yAxisID: 'y1' }
  ]},
  options: { animation: false, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
    scales: { y: { min: 0, max: 1023, title: { display: true, text: 'Gas (ADC)' } }, y1: { min: 0, max: 1, display: false }, x: { ticks: { maxTicksLimit: 8 } } },
    plugins: { legend: { position: 'bottom' } } }
});

function query() {
  const p = $('preset').value;
  if (p !== 'custom') return 'range=' + p;
  const f = $('from').value, t = $('to').value;
  const s = f ? Math.floor(new Date(f) / 1000) : 0, e = t ? Math.floor(new Date(t) / 1000) : Math.floor(Date.now() / 1000) + 60;
  return 'start=' + s + '&end=' + e;
}
function cell(tr, text) { const td = document.createElement('td'); td.textContent = text; tr.appendChild(td); }
function tm(ts) { return new Date(ts * 1000).toLocaleString(); }

async function load() {
  const q = query();
  $('csv').href = '/export.csv?' + q;
  try {
    const r = await fetch('/api/history?' + q, { cache: 'no-store' });
    if (!r.ok) throw new Error(r.status);
    const d = await r.json();
    const span = d.chart.length > 1 ? d.chart[d.chart.length - 1].t - d.chart[0].t : 0;
    chart.data.labels = d.chart.map(p => span > 86400 ? new Date(p.t * 1000).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : new Date(p.t * 1000).toLocaleTimeString());
    chart.data.datasets[0].data = d.chart.map(p => p.gas);
    chart.data.datasets[1].data = d.chart.map(() => d.threshold);
    chart.data.datasets[2].data = d.chart.map(p => p.vib);
    chart.update('none');
    $('empty').hidden = d.chart.length > 0;
    $('sN').textContent = d.stats.n; $('sMax').textContent = d.stats.max_gas ?? '--';
    $('sAvg').textContent = d.stats.avg_gas ?? '--'; $('sVib').textContent = d.stats.vib_samples ?? 0; $('sAlerts').textContent = d.alerts.length;
    $('alerts').replaceChildren(...d.alerts.map(a => { const tr = document.createElement('tr'); cell(tr, tm(a.ts)); cell(tr, a.kind); cell(tr, a.message); cell(tr, a.email_sent ? 'Sent' : '-'); return tr; }));
    $('rows').replaceChildren(...d.rows.map(x => { const tr = document.createElement('tr'); cell(tr, tm(x.ts)); cell(tr, x.gas); cell(tr, x.vib ? 'Detected' : 'No'); cell(tr, x.status); return tr; }));
  } catch (e) { $('empty').hidden = false; $('empty').textContent = 'Could not load history: ' + e.message; }
}
$('preset').onchange = () => { $('customBox').hidden = $('preset').value !== 'custom'; if ($('preset').value !== 'custom') load(); };
$('apply').onclick = load;
load(); setInterval(() => { if ($('preset').value !== 'custom') load(); }, 15000);
</script>
</body>
</html>
